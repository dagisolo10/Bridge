{
    "extends": ["@electron-toolkit/tsconfig/tsconfig.web.json", "@package/typescript-config"],
    "include": ["./src/renderer/src/**/*", "./src/preload/*.d.ts", "./src/shared/**/*", "./postcss.config.mjs"],
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "paths": {
            "@shared/*": ["./src/shared/*"],
            "@/*": ["./src/renderer/src/*"]
        }
    }
}
