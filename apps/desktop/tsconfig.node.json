{
    "extends": ["@electron-toolkit/tsconfig/tsconfig.node.json", "@package/typescript-config"],
    "include": ["electron.vite.config.*", "./src/main/**/*", "./src/preload/**/*", "./src/shared/**/*"],
    "compilerOptions": {
        "composite": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "types": ["electron-vite/node", "node"],
        "paths": {
            "@main/*": ["./src/main/*"],
            "@shared/*": ["./src/shared/*"],
            "@preload/*": ["./src/preload/*"],
            "@server/*": ["./src/main/server/*"]
        }
    },
    "exclude": ["node_modules", "dist"]
}
