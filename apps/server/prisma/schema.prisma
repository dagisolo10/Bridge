generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model Device {
    id        String     @id @default(uuid())
    type      DeviceType
    name      String
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    tokens    Token[]
}

enum DeviceType {
    Phone
    Computer
}

model Token {
    id            String  @id @default(uuid())
    currentToken  String
    previousToken String?
    device        Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
    deviceId      String

    @@index([deviceId])
}
