generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model Device {
    id        String     @id @default(uuid())
    type      DeviceType
    name      String
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    tokens               Token[]
    peers                Peer[]        @relation("PeerDevice")
    parents              Peer[]        @relation("ParentDevice")
    sentPeerRequests     PeerRequest[] @relation("SentPeerRequests")
    receivedPeerRequests PeerRequest[] @relation("ReceivedPeerRequests")
}

enum DeviceType {
    Phone
    Computer
}

model Token {
    id            String  @id @default(uuid())
    currentToken  String
    previousToken String?
    device        Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
    deviceId      String

    @@index([deviceId])
}

model Peer {
    id       String @id @default(uuid())
    peerId   String
    parentId String

    isBlocked Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    peer      Device     @relation("PeerDevice", fields: [peerId], references: [id], onDelete: Cascade)
    parent    Device     @relation("ParentDevice", fields: [parentId], references: [id], onDelete: Cascade)
    peerRules PeerRule[]

    @@unique([peerId, parentId])
    @@index([parentId])
    @@index([peerId])
}

model Rule {
    id          String   @id @default(uuid())
    key         RuleKey  @unique
    name        String
    description String?
    isDefault   Boolean  @default(false)
    createdAt   DateTime @default(now())

    peerRules PeerRule[]
}

model PeerRule {
    id        String   @id @default(uuid())
    peerId    String
    ruleId    String
    isAllowed Boolean
    createdAt DateTime @default(now())

    peer Peer @relation(fields: [peerId], references: [id], onDelete: Cascade)
    rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

    @@unique([peerId, ruleId])
}

model PeerRequest {
    id       String @id @default(uuid())
    parentId String
    peerId   String

    resolvedAt DateTime?
    accepted   Boolean   @default(false)
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    peer   Device @relation("SentPeerRequests", fields: [peerId], references: [id], onDelete: Cascade)
    parent Device @relation("ReceivedPeerRequests", fields: [parentId], references: [id], onDelete: Cascade)

    @@unique([parentId, peerId])
}

enum RuleKey {
    FILE_SHARING
    AUDIO_STREAM
    SYSTEM_POWER
    MEDIA_CONTROL
    VOLUME_CONTROL
    CLIPBOARD_SYNC
    MOUSE_TRACKPAD
    KEYBOARD_TYPEPAD
    FILE_SYSTEM_ACCESS
}
